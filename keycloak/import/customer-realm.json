{
  "realm": "customer",
  "displayName": "fullstack-lab マイページ",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "一般利用者"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fullstack-lab-customer",
      "name": "fullstack-lab (customer)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CUSTOMER_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${CUSTOMER_APP_URL}/oauth2/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CUSTOMER_APP_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fullstack-lab-customer",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "auth-api",
      "name": "認証 API（サービスアカウント）",
      "description": "認証 API が Admin API を呼ぶためのクライアント。Direct Access Grants は現在のパスワードの確認にだけ使う",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${AUTH_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Customer",
      "realmRoles": [
        "customer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${LOCAL_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Customer",
      "realmRoles": [
        "customer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${LOCAL_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-auth-api",
      "enabled": true,
      "serviceAccountClientId": "auth-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    }
  ]
}
